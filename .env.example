# Server configuration
PORT=5005

# Path to a real Chrome binary. Leave empty to use Playwright's bundled Chromium.
CHROME_PATH=

# Directory to persist browser user profile/cookies
USER_DATA_DIR=./user_data

# Scraper timeout in milliseconds (default: 20 seconds)
SCRAPER_TIMEOUT=20000

# Proxy mode upstream timeout in milliseconds (default: 30 seconds)
PROXY_UPSTREAM_TIMEOUT_MS=30000

# Maximum concurrent browser tabs (concurrency limit to safeguard RAM)
MAX_CONCURRENT_SCRAPES=3

# Maximum items in in-memory cache before FIFO eviction
CACHE_MAX_ITEMS=1000

# Recycle browser context after N scrape operations to prevent V8 memory fragmentation
MAX_BROWSER_USES=300

# Optional proxy server for Playwright browser requests (e.g. http://user:pass@host:port)
PROXY_SERVER=

# Headless mode for Playwright (true/false)
HEADLESS=true

